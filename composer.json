{
    "name": "apixx/flysystem-qiniu",
    "description": "Flysystem adapter for Qiniu storage, PHP 8.0 - 8.5 compatible",
    "type": "library",
    "keywords": [
        "thinkphp",
        "flysystem",
        "qiniu",
        "七牛"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "overtrue",
            "email": "i@overtrue.me"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^6.1 || ^8.0",
        "league/flysystem": "^3.0",
        "qiniu/php-sdk": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "apixx\\Qiniu\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "apixx\\Qiniu\\Tests\\": "tests"
        }
    },
    "scripts": {
        "check-style": "php-cs-fixer fix --using-cache=no --diff --dry-run --ansi",
        "fix-style": "php-cs-fixer fix --using-cache=no --ansi",
        "test": "vendor/bin/phpunit"
    },
    "scripts-descriptions": {
        "test": "Run all tests.",
        "check-style": "Run style checks (only dry run - no fixing!).",
        "fix-style": "Run style checks and fix violations."
    }
}
